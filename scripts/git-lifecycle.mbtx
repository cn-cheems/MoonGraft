----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}
----

///|
async fn git(repository : String, args : Array[String]) -> String {
  let output = @shell.Cmd("git", args, cwd=repository).output()
  output.check()
  output.stdout().trim().to_owned()
}

///|
async fn commit(repository : String, message : String) -> String {
  ignore(git(repository, ["add", "."]))
  ignore(
    git(repository, [
      "-c", "user.name=MoonGraft fixture", "-c", "user.email=fixture@example.invalid",
      "-c", "commit.gpgSign=false", "commit", "-m", message,
    ]),
  )
  git(repository, ["rev-parse", "HEAD"])
}

///|
async fn cli(args : Array[String], error? : String) -> String {
  let target = if @env.args()[1:] is ["native"] { "native" } else { "wasm" }
  let output = @shell.Cmd(
    "moon",
    ["run", "--target", target, "--deny-warn", "cmd/main", "--"] + args,
  ).output()
  match error {
    None => output.check()
    Some(message) => {
      guard output.exit_code() != 0 && output.stderr().contains(message) else {
        fail(
          "Expected diagnostic " +
          message +
          ": " +
          output.stdout() +
          output.stderr(),
        )
      }
    }
  }
  output.stdout()
}

///|
async fn check_parameterized_lifecycle(root : String) -> Unit {
  let repository = root + "/parameterized-template"
  @fs.mkdir(repository)
  ignore(git(repository, ["init", "--object-format=sha1"]))
  ignore(git(repository, ["config", "core.autocrlf", "false"]))
  @fs.write_file(
    repository + "/moongraft.render.json",
    "[\"moongraft.render\",\"1\",[[\"project\"],[\"@{project}.conf\"]]]",
  )
  @fs.write_file(repository + "/asset.bin", b"\x00\xff@{project}")
  let revisions = []
  for version in ["1", "2", "3"] {
    @fs.write_file(
      repository + "/@{project}.conf",
      "name=@{project}\nstatus=stable\nrevision=" + version + "\n",
    )
    revisions.push(commit(repository, "Template version " + version))
  }
  @fs.write_file(
    repository + "/@{project}.conf",
    "dirty checkout must be ignored",
  )
  for name in ["red", "blue"] {
    let params = root + "/" + name + "-parameters.json"
    @fs.write_file(
      params,
      "[\"moongraft.parameters\",\"1\",[[\"project\",\"" + name + "\"]]]",
    )
    let prefix = root + "/" + name
    let mut source = prefix + "-v1.json"
    ignore(
      cli([
        "capture-git-rendered",
        repository,
        revisions[0],
        ".",
        params,
        source,
      ]),
    )
    ignore(cli(["verify-git-source", source]))
    let generated = prefix + "-generated"
    ignore(cli(["create-git", source, generated]))
    let mut project = generated + "/project"
    guard @fs.read_file(project + "/" + name + ".conf").text() ==
      "name=" + name + "\nstatus=stable\nrevision=1\n" &&
      @fs.read_file(project + "/asset.bin").binary() == b"\x00\xff@{project}" &&
      !@fs.exists(project + "/moongraft.render.json") else {
      fail("Rendered project differs from the pinned inputs")
    }
    @fs.write_file(
      project + "/" + name + ".conf",
      "name=" + name + "\nstatus=local\nrevision=1\n",
    )
    for index in 1..<revisions.length() {
      let version = (index + 1).to_string()
      let plan = prefix + "-plan-v" + version + ".json"
      ignore(cli(["plan-git", source, project, revisions[index], plan]))
      let bundle = prefix + "-candidate-v" + version
      ignore(cli(["export", plan, project, bundle]))
      project = bundle + "/project"
      guard @fs.read_file(project + "/" + name + ".conf").text() ==
        "name=" + name + "\nstatus=local\nrevision=" + version + "\n" else {
        fail(
          "Parameterized upgrade failed to preserve the project's local change",
        )
      }
      let next = prefix + "-v" + version + ".json"
      ignore(cli(["accept-git", source, plan, project, next]))
      let direct = prefix + "-direct-v" + version + ".json"
      ignore(
        cli([
          "capture-git-rendered",
          repository,
          revisions[index],
          ".",
          params,
          direct,
        ]),
      )
      guard @fs.read_file(next).binary() == @fs.read_file(direct).binary() else {
        fail("Adopted parameterized source differs from a fresh render")
      }
      source = next
    }
  }
  let tampered = root + "/tampered-parameterized-source.json"
  let original = @fs.read_file(root + "/red-v1.json").text()
  let changed = original.replace_all(old="737461626c65", new="7374616c65")
  guard changed != original else { fail("Missing baseline edit fixture") }
  @fs.write_file(tampered, changed)
  ignore(
    cli(
      ["verify-git-source", tampered],
      error="differs from the recorded baseline",
    ),
  )
  let invalid = root + "/tampered-generated"
  ignore(
    cli(
      ["create-git", tampered, invalid],
      error="differs from the recorded baseline",
    ),
  )
  guard !@fs.exists(invalid) else {
    fail("Invalid baseline created an output bundle")
  }
  let previous = repository + "/@{project}.conf"
  let renamed = repository + "/@{service}.conf"
  @fs.rename(previous, renamed, replace=false)
  @fs.write_file(
    repository + "/moongraft.render.json",
    "[\"moongraft.render\",\"1\",[[\"service\",\"tier\"],[\"@{service}.conf\"]]]",
  )
  @fs.write_file(
    renamed, "name=@{service}\nstatus=stable\nrevision=4\ntier=@{tier}\n",
  )
  let fourth = commit(repository, "Rename project parameter and introduce tier")
  @fs.write_file(
    renamed, "name=@{service}\nstatus=stable\nrevision=5\ntier=@{tier}\n",
  )
  let fifth = commit(repository, "Follow-up on the migrated template")
  let rules = root + "/parameter-migration.json"
  @fs.write_file(
    rules, "[\"moongraft.parameter-migration\",\"1\",[[[\"project\",\"service\"]],[[\"tier\",\"standard\"]],[]]]",
  )
  let source = root + "/red-v3.json"
  let project = root + "/red-candidate-v3/project"
  let plan = root + "/migrate-parameters.json"
  ignore(
    cli(
      ["plan-git", source, project, fourth, root + "/missing-migration.json"],
      error="exact supplied parameters",
    ),
  )
  let report = cli(["plan-git-parameters", source, project, fourth, rules, plan])
  guard report.contains("parameter-rename\tproject\tservice") &&
    report.contains("parameter-default\ttier") else {
    fail("Migration was not visible in the review")
  }
  let refreshed = root + "/migrate-parameters-refreshed.json"
  ignore(cli(["refresh", plan, project, refreshed]))
  guard @fs.read_file(refreshed).binary() == @fs.read_file(plan).binary() else {
    fail("Refresh failed to preserve the parameter migration")
  }
  let bundle = root + "/migrate-parameter-candidate"
  ignore(cli(["export", refreshed, project, bundle]))
  let candidate = bundle + "/project"
  guard @fs.read_file(candidate + "/red.conf").text() ==
    "name=red\nstatus=local\nrevision=4\ntier=standard\n" else {
    fail("Migrated candidate did not preserve its local customization")
  }
  let adopted = root + "/red-v4.json"
  ignore(cli(["accept-git", source, refreshed, candidate, adopted]))
  ignore(cli(["verify-git-source", adopted]))
  let rollback = root + "/migrate-parameter-rollback"
  ignore(cli(["rollback-export", plan, candidate, rollback]))
  guard @fs.read_file(rollback + "/baseline.json").binary() ==
    @fs.read_file(root + "/red-candidate-v3/baseline.json").binary() &&
    @fs.read_file(rollback + "/project/red.conf").binary() ==
    @fs.read_file(project + "/red.conf").binary() else {
    fail(
      "Migration rollback did not restore the old template identity and snapshot",
    )
  }
  let next_plan = root + "/red-post-migration.json"
  let next_bundle = root + "/red-post-migration"
  ignore(cli(["plan-git", adopted, candidate, fifth, next_plan]))
  ignore(cli(["export", next_plan, candidate, next_bundle]))
  guard @fs.read_file(next_bundle + "/project/red.conf").text() ==
    "name=red\nstatus=local\nrevision=5\ntier=standard\n" else {
    fail("The adopted recipe could not drive another upgrade")
  }
}

///|
async fn check_json_lifecycle(root : String) -> Unit {
  let repository = root + "/json-template"
  @fs.mkdir(repository)
  ignore(git(repository, ["init", "--object-format=sha1"]))
  ignore(git(repository, ["config", "core.autocrlf", "false"]))
  let path = "service.json"
  @fs.write_file(repository + "/" + path, "{\"http\":{\"timeout\":10}}\n")
  let first = commit(repository, "Initial HTTP settings")
  @fs.write_file(
    repository + "/" + path,
    "{\"http\":{\"timeout\":10,\"retries\":3}}\n",
  )
  let next = commit(repository, "Add a retry setting")
  let source = root + "/json-source.json"
  ignore(cli(["capture-git", repository, first, ".", source]))
  let original = root + "/json-project"
  ignore(cli(["create-git", source, original]))
  let project = original + "/project"
  @fs.write_file(project + "/" + path, "{\"http\":{\"timeout\":30}}\n")
  let selection = root + "/json-paths.json"
  @fs.write_file(
    selection, "[\"moongraft.json-merge\",\"1\",[\"service.json\"]]",
  )
  let plan = root + "/json-plan.json"
  let report = cli(["plan-git-json", source, project, next, selection, plan])
  guard report.contains("merged-json\tservice.json") &&
    report.contains("Unresolved: 0") else {
    fail("Git plan did not recognize independent JSON field edits")
  }
  let directory_plan = root + "/json-directory-plan.json"
  ignore(
    cli([
      "plan-json",
      original + "/baseline.json",
      project,
      next,
      repository,
      selection,
      directory_plan,
    ]),
  )
  guard @fs.read_file(plan).binary() == @fs.read_file(directory_plan).binary() else {
    fail("Git and rendered directories produced different JSON plans")
  }
  let bundle = root + "/json-candidate"
  ignore(cli(["export", plan, project, bundle]))
  ignore(cli(["verify-export", bundle]))
  let candidate = bundle + "/project"
  guard @fs.read_file(candidate + "/" + path).binary() ==
    b"{\"http\":{\"retries\":3,\"timeout\":30}}\n" else {
    fail("JSON candidate lost either the local timeout or the upstream retries")
  }
  let adopted = root + "/json-adopted.json"
  ignore(cli(["accept-git", source, plan, candidate, adopted]))
  let rollback = root + "/json-rollback"
  ignore(cli(["rollback-export", plan, candidate, rollback]))
  guard @fs.read_file(rollback + "/project/" + path).binary() ==
    @fs.read_file(project + "/" + path).binary() else {
    fail("JSON rollback changed the original file bytes")
  }
  @fs.write_file(
    repository + "/" + path,
    "{\"http\":{\"timeout\":20,\"retries\":3}}\n",
  )
  let conflicting = commit(repository, "Revise the upstream timeout")
  let conflict_plan = root + "/json-conflicts.json"
  let conflict_report = cli([
    "plan-git-json", adopted, candidate, conflicting, selection, conflict_plan,
  ])
  let machine = cli(["report-json", conflict_plan])
  guard conflict_report.contains(
      "json-conflict\tservice.json\t\"/http/timeout\"",
    ) &&
    machine.contains("[\"service.json\",[\"/http/timeout\"]]") else {
    fail("JSON conflict reports did not identify the field")
  }
  let blocked = root + "/unresolved-json"
  ignore(
    cli(
      ["export", conflict_plan, candidate, blocked],
      error="Resolve these conflicts",
    ),
  )
  guard !@fs.exists(blocked) else {
    fail("Unresolved JSON created an export directory")
  }
  let replacement = root + "/resolved-service.json"
  @fs.write_file(replacement, "{\"http\":{\"timeout\":25,\"retries\":3}}\n")
  let resolved = root + "/json-resolved.json"
  ignore(cli(["replace", conflict_plan, path, replacement, resolved]))
  let resolved_bundle = root + "/json-resolved"
  ignore(cli(["export", resolved, candidate, resolved_bundle]))
  guard @fs.read_file(resolved_bundle + "/project/" + path).binary() ==
    @fs.read_file(replacement).binary() else {
    fail("Reviewed JSON replacement was not preserved")
  }
}

///|
async fn check_remote_pin(root : String) -> Unit {
  let remote = root + "/remote template"
  let repository = root + "/pin-repository"
  let tag = "refs/tags/release"
  @fs.mkdir(remote)
  ignore(git(remote, ["init", "--initial-branch=main", "--object-format=sha1"]))
  ignore(git(remote, ["config", "core.autocrlf", "false"]))
  @fs.write_file(remote + "/service.json", "{\"http\":{\"timeout\":10}}\n")
  let base = commit(remote, "Initial service settings")
  ignore(git(root, ["clone", "--no-local", remote, repository]))
  ignore(git(repository, ["fetch", "origin"]))
  ignore(git(repository, ["config", "fetch.prune", "true"]))
  ignore(git(repository, ["config", "fetch.pruneTags", "true"]))
  ignore(git(repository, ["tag", "local-only", base]))
  let fetch_head = repository + "/.git/FETCH_HEAD"
  let fetch_snapshot = @fs.read_file(fetch_head).binary()
  let ordinary_refs = [
    "for-each-ref", "refs/heads", "refs/tags", "refs/remotes",
  ]
  let refs_snapshot = git(repository, ordinary_refs)
  let source = root + "/pin-source.json"
  ignore(cli(["capture-git", repository, base, ".", source]))
  let generated = root + "/pin-project"
  ignore(cli(["create-git", source, generated]))
  let project = generated + "/project"
  @fs.write_file(project + "/service.json", "{\"http\":{\"timeout\":30}}\n")
  let selection = root + "/pin-json-paths.json"
  @fs.write_file(
    selection, "[\"moongraft.json-merge\",\"1\",[\"service.json\"]]",
  )
  let pin = ["pin-git-ref", repository, "origin", tag]
  ignore(cli(pin, error="Remote Git ref not found"))
  ignore(
    cli(
      ["pin-git-ref", repository, "origin", "refs/tags/*"],
      error="Invalid remote Git ref name",
    ),
  )
  ignore(
    cli(
      ["pin-git-ref", repository, remote, tag],
      error="Use the name of a configured Git remote",
    ),
  )
  @fs.write_file(
    remote + "/service.json",
    "{\"http\":{\"timeout\":10,\"retries\":3}}\n",
  )
  let first = commit(remote, "Add a retry limit")
  ignore(
    git(remote, [
      "-c", "user.name=MoonGraft fixture", "-c", "user.email=fixture@example.invalid",
      "-c", "tag.gpgSign=false", "tag", "-a", "release", "-m", "First release", first,
    ]),
  )
  let pinned = cli(pin).trim().to_owned()
  guard pinned == first && cli(pin).trim() == first else {
    fail("Annotated tag did not pin its commit idempotently")
  }
  let first_plan = root + "/first-pinned-plan.json"
  ignore(cli(["plan-git-json", source, project, pinned, selection, first_plan]))
  ignore(git(remote, ["switch", "-c", "replacement", base]))
  @fs.write_file(
    remote + "/service.json",
    "{\"http\":{\"timeout\":10,\"retries\":5}}\n",
  )
  let second = commit(remote, "Set another retry limit")
  ignore(git(remote, ["tag", "-f", "release", second]))
  let moved = cli(pin).trim().to_owned()
  let branch = cli([
    "pin-git-ref", repository, "origin", "refs/heads/replacement",
  ]).trim()
  guard moved == second && branch == second && moved != pinned else {
    fail("Moved tag or remote branch did not report the new commit")
  }
  let blob = git(remote, ["rev-parse", second + ":service.json"])
  ignore(git(remote, ["tag", "not-a-commit", blob]))
  ignore(
    cli(
      ["pin-git-ref", repository, "origin", "refs/tags/not-a-commit"],
      error="Remote Git ref does not identify a commit",
    ),
  )
  guard git(repository, ordinary_refs) == refs_snapshot &&
    @fs.read_file(fetch_head).binary() == fetch_snapshot else {
    fail("Remote pin updated normal refs or FETCH_HEAD")
  }
  let new_plan = root + "/moved-pinned-plan.json"
  let report = cli([
    "plan-git-json", source, project, moved, selection, new_plan,
  ])
  guard report.contains(base + " -> " + second) else {
    fail("New plan did not show the new commit")
  }
  ignore(git(repository, ["remote", "remove", "origin"]))
  ignore(git(repository, ["gc", "--prune=now"]))
  let replay = root + "/offline-pinned-plan.json"
  ignore(cli(["plan-git-json", source, project, pinned, selection, replay]))
  guard @fs.read_file(replay).binary() == @fs.read_file(first_plan).binary() else {
    fail(
      "The old plan changed after moving the tag and pruning unreachable objects",
    )
  }
  let candidate = root + "/first-pinned-candidate"
  ignore(cli(["export", first_plan, project, candidate]))
  guard @fs.read_file(candidate + "/project/service.json").binary() ==
    b"{\"http\":{\"retries\":3,\"timeout\":30}}\n" else {
    fail("Offline export changed the selected version or local configuration")
  }
  ignore(
    cli([
      "accept-git",
      source,
      first_plan,
      candidate + "/project",
      root + "/accepted-pin.json",
    ]),
  )
}

///|
async fn main {
  let root = @fs.tmpdir(prefix="moongraft-git-")
  check_parameterized_lifecycle(root)
  check_json_lifecycle(root)
  check_remote_pin(root)
  let repository = root + "/template"
  @fs.mkdir(repository)
  ignore(git(repository, ["init", "--object-format=sha1"]))
  ignore(git(repository, ["config", "core.autocrlf", "false"]))
  @fs.mkdir(repository + "/service")
  @fs.write_file(repository + "/outside.txt", "outside")
  @fs.write_file(repository + "/service/settings.txt", "version=1\n")
  @fs.write_file(repository + "/service/logo.bin", b"\x00\xff")
  let first = commit(repository, "service template v1")
  @fs.write_file(repository + "/service/settings.txt", "version=2\n")
  let second = commit(repository, "service template v2")
  @fs.write_file(repository + "/service/guide.md", "Run the service tests.\n")
  let third = commit(repository, "service template v3")
  ignore(git(repository, ["tag", "v1", first]))
  ignore(git(repository, ["tag", "v2", second]))
  let first_tree = git(repository, ["rev-parse", first + "^{tree}"])
  let unrelated = git(repository, [
    "-c", "user.name=MoonGraft fixture", "-c", "user.email=fixture@example.invalid",
    "-c", "commit.gpgSign=false", "commit-tree", first_tree, "-m", "Unrelated history",
  ])
  ignore(git(repository, ["tag", "unrelated", unrelated]))
  ignore(
    git(repository, [
      "-c", "user.name=MoonGraft fixture", "-c", "user.email=fixture@example.invalid",
      "-c", "tag.gpgSign=false", "tag", "-a", "v3", "-m", "Release v3", third,
    ]),
  )
  ignore(
    git(repository, ["update-ref", "refs/remotes/upstream/service", third]),
  )
  @fs.write_file(repository + "/service/settings.txt", "uncommitted\n")

  let source = root + "/source.json"
  let duplicate = root + "/duplicate.json"
  let bundle = root + "/generated"
  ignore(
    cli(
      ["capture-git", repository, "HEAD", "service", duplicate],
      error="40-character Git commit SHA",
    ),
  )
  ignore(
    cli(
      ["capture-git", repository, first, "missing", duplicate],
      error="contains no files",
    ),
  )
  guard !@fs.exists(duplicate) else {
    fail("Invalid capture created an archive")
  }
  ignore(cli(["capture-git", repository, first, "service", source]))
  ignore(cli(["capture-git", repository, first, "service", duplicate]))
  guard @fs.read_file(source).binary() == @fs.read_file(duplicate).binary() else {
    fail("Repeated source capture must be byte-identical")
  }
  ignore(cli(["create-git", source, bundle]))
  ignore(cli(["verify-export", bundle]))
  guard @fs.read_file(bundle + "/project/settings.txt").binary() ==
    b"version=1\n" &&
    @fs.read_file(bundle + "/project/logo.bin").binary() == b"\x00\xff" &&
    !@fs.exists(bundle + "/project/outside.txt") else {
    fail("Generation failed to reproduce the selected committed subtree")
  }
  let unchanged = cli(["check-git", source, first])
  let changed = cli(["check-git", source, second])
  guard unchanged.contains("Already recorded") &&
    changed.contains("template changes") else {
    fail("Unexpected source version check")
  }
  let project = bundle + "/project"
  let existing = root + "/existing-service"
  let plan = root + "/plan.json"
  let resolved = root + "/resolved.json"
  let candidate = root + "/candidate"
  let advanced = root + "/source-v2.json"
  let original = @fs.read_file(source).binary()
  @fs.mkdir(existing)
  @fs.write_file(existing + "/settings.txt", "version=team\n")
  @fs.write_file(existing + "/business.txt", "team feature\n")
  @fs.write_file(existing + "/logo.bin", b"\x00\xff")
  let linked = root + "/linked.json"
  let link_report = cli([
    "link-git", repository, first, "service", existing, linked,
  ])
  guard link_report.contains("keep-local\tbusiness.txt") &&
    @fs.read_file(linked).binary() == original else {
    fail(
      "Link must report local customization and record only the chosen template baseline",
    )
  }
  let invalid = existing + "/source.json"
  ignore(
    cli(
      ["link-git", repository, first, "service", existing, invalid],
      error="must be outside the source project",
    ),
  )
  guard !@fs.exists(invalid) else {
    fail("Link wrote into the existing project")
  }
  ignore(
    cli(
      ["link-git", repository, second, "service", existing, linked],
      error="linked.json",
    ),
  )
  guard @fs.read_file(linked).binary() == original else {
    fail("Link overwrote a prior record")
  }
  let versions = cli(["discover-git", linked])
  guard versions == cli(["discover-git", linked]) &&
    !versions.contains("refs/tags/v1") &&
    !versions.contains("refs/tags/unrelated") &&
    versions.contains(
      "\"ref\":\"refs/tags/v2\",\"revision\":\"" + second + "\"",
    ) &&
    versions.contains("\"ref\":\"refs/tags/v3\",\"revision\":\"" + third + "\"") &&
    versions.contains(
      "\"ref\":\"refs/remotes/upstream/service\",\"revision\":\"" + third + "\"",
    ) else {
    fail("Unexpected pinned descendant versions: " + versions)
  }
  let batch_manifest = root + "/batch.json"
  let batch = root + "/batch"
  let rejected = root + "/rejected"
  let jobs = [
    ["z-ready", source, project, second],
    ["a-conflict", linked, existing, second],
    ["bad-sha", source, project, "HEAD"],
  ].map(row => Json::array(row.map(Json::string)))
  @fs.write_file(
    batch_manifest,
    Json::array([
      Json::string("moongraft.git-batch.v1"),
      Json::array([jobs[0], jobs[0]]),
    ]).stringify(),
  )
  ignore(
    cli(
      ["stage-git-batch", batch_manifest, rejected],
      error="Duplicate project ID",
    ),
  )
  guard !@fs.exists(rejected) else {
    fail("Invalid manifest created an output directory")
  }
  @fs.write_file(
    batch_manifest,
    Json::array([Json::string("moongraft.git-batch.v1"), Json::array(jobs)]).stringify(),
  )
  ignore(
    cli(
      ["stage-git-batch", batch_manifest, existing + "/unsafe"],
      error="must be outside",
    ),
  )
  guard !@fs.exists(existing + "/unsafe") else {
    fail("Batch wrote inside a project")
  }
  let batch_report = cli(["stage-git-batch", batch_manifest, batch])
  let report_json = @fs.read_file(batch + "/report.json").text()
  guard batch_report.trim() == report_json.trim() &&
    batch_report.contains("\"status\":\"ready\"") &&
    batch_report.contains("\"status\":\"conflicts\"") &&
    batch_report.contains("\"status\":\"error\"") &&
    batch_report.contains("40-character Git commit SHA") &&
    batch_report.contains("settings.txt") &&
    !@fs.exists(batch + "/a-conflict/candidate") &&
    @fs.read_file(batch + "/z-ready/candidate/project/settings.txt").binary() ==
    b"version=2\n" &&
    @fs.read_file(source).binary() == original &&
    @fs.read_file(linked).binary() == original else {
    fail(
      "Batch must emit an independent candidate, isolated diagnostics and unchanged source records",
    )
  }
  ignore(cli(["verify-export", batch + "/z-ready/candidate"]))
  ignore(
    cli(
      ["check-git-batch", batch + "/report.json"],
      error="a-conflict (conflicts), bad-sha (error)",
    ),
  )
  @fs.write_file(
    root + "/ready-only.json",
    Json::array([Json::string("moongraft.git-batch.v1"), Json::array([jobs[0]])]).stringify(),
  )
  ignore(
    cli(["stage-git-batch", root + "/ready-only.json", root + "/ready-only"]),
  )
  ignore(cli(["check-git-batch", root + "/ready-only/report.json"]))
  let ready_directory = root + "/ready-only"
  guard @fs.read_file(ready_directory + "/manifest.json").binary() ==
    @fs.read_file(root + "/ready-only.json").binary() &&
    @fs.read_file(ready_directory + "/z-ready/source.json").binary() == original else {
    fail("Batch must capture its exact input manifest and template source")
  }
  ignore(cli(["verify-git-batch", ready_directory]))
  let ready_settings = ready_directory +
    "/z-ready/candidate/project/settings.txt"
  @fs.write_file(ready_settings, "unreviewed edit\n")
  ignore(
    cli(
      ["accept-git-batch", ready_directory, root + "/blocked-acceptance"],
      error="Batch project z-ready",
    ),
  )
  guard !@fs.exists(root + "/blocked-acceptance") else {
    fail("Failed batch acceptance created its output directory")
  }
  ignore(
    cli(["verify-git-batch", ready_directory], error="Batch project z-ready"),
  )
  guard @fs.read_file(ready_settings).binary() == b"unreviewed edit\n" else {
    fail("Read-only batch verification modified a candidate")
  }
  @fs.write_file(ready_settings, "version=2\n")
  let ready_report = @fs.read_file(ready_directory + "/report.json").text()
  @fs.write_file(
    ready_directory + "/report.json",
    ready_report.replace_all(old=second, new=first),
  )
  ignore(
    cli(["verify-git-batch", ready_directory], error="Report revision differs"),
  )
  @fs.write_file(ready_directory + "/report.json", ready_report)
  let captured_source = ready_directory + "/z-ready/source.json"
  @fs.remove(captured_source)
  ignore(cli(["verify-git-batch", ready_directory], error="Expected a plan"))
  @fs.write_file(captured_source, original)
  @fs.write_file(ready_directory + "/unexpected.txt", "maintainer file")
  ignore(cli(["verify-git-batch", ready_directory], error="unreported entries"))
  guard @fs.read_file(ready_directory + "/unexpected.txt").binary() ==
    b"maintainer file" else {
    fail("Batch verification modified an unreported file")
  }
  @fs.remove(ready_directory + "/unexpected.txt")
  ignore(cli(["verify-git-batch", ready_directory]))
  @fs.remove(ready_directory + "/manifest.json")
  @fs.remove(captured_source)
  ignore(cli(["verify-git-batch", ready_directory]))
  @fs.write_file(
    ready_directory + "/manifest.json",
    @fs.read_file(root + "/ready-only.json").binary(),
  )
  @fs.write_file(captured_source, original)
  let protected_manifest = root + "/protected-batch.json"
  let policy = root + "/policy.json"
  @fs.write_file(
    protected_manifest,
    Json::array([
      Json::string("moongraft.git-batch.v1"),
      Json::array([
        jobs[0],
        Json::array(["unchanged", source, project, first].map(Json::string)),
      ]),
    ]).stringify(),
  )
  @fs.write_file(
    policy, "[\"moongraft.policy\",\"1\",[100,100,10000,[\"settings.txt\"]]]",
  )
  let protected_output = root + "/protected-output"
  let protected_report = cli([
    "stage-git-batch-checked", protected_manifest, policy, protected_output,
  ])
  guard protected_report.contains("z-ready") &&
    protected_report.contains("Upgrade policy rejected") &&
    protected_report.contains("\"status\":\"error\"") &&
    protected_report.contains("\"status\":\"ready\"") &&
    !@fs.exists(protected_output + "/z-ready/candidate") &&
    @fs.exists(protected_output + "/z-ready/plan.json") else {
    fail(
      "Policy rejection must precede candidate creation and preserve the review plan",
    )
  }
  ignore(cli(["verify-export", protected_output + "/unchanged/candidate"]))
  ignore(
    cli(
      ["check-git-batch", protected_output + "/report.json"],
      error="z-ready (error)",
    ),
  )
  @fs.write_file(policy, "[\"moongraft.policy\",\"1\",[100,100,10000,[]]]")
  ignore(
    cli([
      "stage-git-batch-checked",
      protected_manifest,
      policy,
      root + "/allowed-output",
    ]),
  )
  ignore(cli(["check-git-batch", root + "/allowed-output/report.json"]))
  let allowed_directory = root + "/allowed-output"
  let archived_policy = @fs.read_file(allowed_directory + "/policy.json").binary()
  ignore(cli(["verify-git-batch", allowed_directory]))
  @fs.write_file(
    allowed_directory + "/policy.json",
    Json::array([
      Json::string("moongraft.batch-policy.v1"),
      Json::string(
        "[\"moongraft.policy\",\"1\",[100,100,10000,[\"settings.txt\"]]]",
      ),
    ]).stringify(),
  )
  ignore(
    cli(
      ["verify-git-batch", allowed_directory],
      error="Upgrade policy rejected",
    ),
  )
  @fs.write_file(allowed_directory + "/policy.json", archived_policy)
  guard @fs.read_file(root + "/allowed-output/z-ready/plan.json").binary() ==
    @fs.read_file(batch + "/z-ready/plan.json").binary() else {
    fail("Policies must preserve the upgrade plan")
  }
  @fs.write_file(policy, "{}")
  ignore(cli(["verify-git-batch", allowed_directory]))
  let invalid_output = root + "/invalid-policy"
  ignore(
    cli(["stage-git-batch-checked", protected_manifest, policy, invalid_output]),
  )
  ignore(
    cli(
      ["check-git-batch", invalid_output + "/report.json"],
      error="Batch preparation blocked",
    ),
  )
  guard !@fs.exists(invalid_output + "/unchanged/candidate") &&
    !@fs.exists(invalid_output + "/z-ready/candidate") else {
    fail("Malformed policy allowed a candidate export")
  }
  let individual_manifest = root + "/individual.json"
  let open_policy = root + "/open-policy.json"
  let protected_policy = root + "/protected-policy.json"
  @fs.write_file(open_policy, "[\"moongraft.policy\",\"1\",[10,10,10000,[]]]")
  @fs.write_file(
    protected_policy, "[\"moongraft.policy\",\"1\",[10,10,10000,[\"settings.txt\"]]]",
  )
  @fs.write_file(
    individual_manifest,
    Json::array([
      Json::string("moongraft.git-batch.v2"),
      Json::array([
        Json::array(
          ["a-open", source, project, second, open_policy].map(Json::string),
        ),
        Json::array(
          ["z-protected", source, project, second, protected_policy].map(
            Json::string,
          ),
        ),
      ]),
    ]).stringify(),
  )
  let individual = root + "/individual"
  let individual_report = cli([
    "stage-git-batch", individual_manifest, individual,
  ])
  guard individual_report.contains("\"status\":\"ready\"") &&
    individual_report.contains("\"status\":\"error\"") &&
    !@fs.exists(individual + "/z-protected/candidate") else {
    fail("Each project must enforce its own policy")
  }
  ignore(cli(["verify-export", individual + "/a-open/candidate"]))
  guard @fs.read_file(individual + "/a-open/policy.json").binary() ==
    @fs.read_file(open_policy).binary() else {
    fail("Individual policy snapshot differs from its input")
  }
  ignore(
    cli(
      ["check-git-batch", individual + "/report.json"],
      error="z-protected (error)",
    ),
  )
  let combined = root + "/combined-policy"
  ignore(
    cli([
      "stage-git-batch-checked", individual_manifest, protected_policy, combined,
    ]),
  )
  ignore(
    cli(
      ["check-git-batch", combined + "/report.json"],
      error="a-open (error), z-protected (error)",
    ),
  )
  guard !@fs.exists(combined + "/a-open/candidate") else {
    fail("Individual policy bypassed the common policy")
  }
  @fs.write_file(
    protected_policy, "[\"moongraft.policy\",\"1\",[10,10,10000,[]]]",
  )
  let individual_ready = root + "/individual-ready"
  ignore(cli(["stage-git-batch", individual_manifest, individual_ready]))
  ignore(cli(["verify-git-batch", individual_ready]))
  let individual_snapshot = @fs.read_file(
    individual_ready + "/a-open/policy.json",
  ).binary()
  @fs.remove(individual_ready + "/a-open/policy.json")
  ignore(cli(["verify-git-batch", individual_ready], error="Expected a plan"))
  @fs.write_file(individual_ready + "/a-open/policy.json", individual_snapshot)
  ignore(cli(["verify-git-batch", individual_ready]))
  @fs.remove(open_policy)
  let missing_policy = root + "/missing-policy"
  ignore(cli(["stage-git-batch", individual_manifest, missing_policy]))
  ignore(
    cli(
      ["check-git-batch", missing_policy + "/report.json"],
      error="a-open (error)",
    ),
  )
  guard !@fs.exists(missing_policy + "/a-open/candidate") else {
    fail("Missing individual policy allowed export")
  }
  let individual_retry = root + "/retry-individual.json"
  ignore(
    cli([
      "retry-git-batch",
      individual + "/manifest.json",
      individual + "/report.json",
      individual_retry,
    ]),
  )
  let individual_retry_text = @fs.read_file(individual_retry).text()
  guard individual_retry_text.contains("moongraft.git-batch.v2") &&
    individual_retry_text.contains(Json::string(protected_policy).stringify()) &&
    !individual_retry_text.contains("a-open") else {
    fail("Retry lost the individual policy or included a ready project")
  }
  ignore(cli(["stage-git-batch", individual_retry, root + "/retry-individual"]))
  ignore(cli(["verify-git-batch", root + "/retry-individual"]))
  @fs.write_file(
    individual_manifest,
    Json::array([Json::string("moongraft.git-batch.v2"), Json::array([jobs[0]])]).stringify(),
  )
  ignore(
    cli(
      ["stage-git-batch", individual_manifest, root + "/invalid-v2"],
      error="does not match its manifest version",
    ),
  )
  guard !@fs.exists(root + "/invalid-v2") else {
    fail("Malformed v2 created an output directory")
  }
  let retry_manifest = root + "/retry-manifest.json"
  ignore(
    cli([
      "retry-git-batch",
      batch_manifest,
      batch + "/report.json",
      retry_manifest,
    ]),
  )
  let retry_text = @fs.read_file(retry_manifest).text()
  guard retry_text.contains("a-conflict") &&
    retry_text.contains("bad-sha") &&
    !retry_text.contains("z-ready") &&
    retry_text.contains("HEAD") else {
    fail("Retry must preserve failed inputs and exclude ready projects")
  }
  @fs.write_file(retry_manifest, retry_text.replace_all(old="HEAD", new=second))
  @fs.write_file(existing + "/settings.txt", "version=1\n")
  ignore(cli(["stage-git-batch", retry_manifest, root + "/retry-output"]))
  ignore(cli(["verify-git-batch", root + "/retry-output"]))
  let no_retry = root + "/unnecessary-retry.json"
  ignore(
    cli([
      "retry-git-batch",
      retry_manifest,
      root + "/retry-output/report.json",
      no_retry,
    ]),
  )
  guard !@fs.exists(no_retry) else {
    fail("All-ready batch generated an empty retry manifest")
  }
  @fs.write_file(existing + "/settings.txt", "version=team\n")
  let repeat = cli(["stage-git-batch", batch_manifest, root + "/repeat"])
  guard batch_report == repeat else {
    fail("Expected deterministic batch reports")
  }
  let report = cli(["plan-git", linked, existing, second, plan])
  guard @fs.read_file(batch + "/a-conflict/plan.json").binary() ==
    @fs.read_file(plan).binary() else {
    fail(
      "Batch conflict plan must remain compatible with the single-project review flow",
    )
  }
  guard report.contains("Unresolved: 1") else {
    fail("Expected overlapping settings edits to require a decision")
  }
  ignore(
    cli(["export", plan, existing, candidate], error="Resolve these conflicts"),
  )
  ignore(
    cli([
      "resolve",
      batch + "/a-conflict/plan.json",
      "settings.txt",
      "take-template",
      resolved,
    ]),
  )
  ignore(cli(["export", resolved, existing, candidate]))
  let accepted = candidate + "/project"
  guard @fs.read_file(accepted + "/settings.txt").binary() == b"version=2\n" &&
    @fs.read_file(accepted + "/business.txt").binary() == b"team feature\n" &&
    @fs.read_file(existing + "/settings.txt").binary() == b"version=team\n" &&
    @fs.read_file(project + "/settings.txt").binary() == b"version=1\n" else {
    fail(
      "Candidate must contain the chosen template edit and preserve business files",
    )
  }
  @fs.write_file(accepted + "/business.txt", "unexpected edit\n")
  ignore(
    cli(
      ["accept-git", source, resolved, accepted, advanced],
      error="differs from the resolved candidate",
    ),
  )
  guard !@fs.exists(advanced) && @fs.read_file(source).binary() == original else {
    fail("Failed acceptance wrote a source record")
  }
  @fs.write_file(accepted + "/business.txt", "team feature\n")
  ignore(cli(["accept-git", source, resolved, accepted, advanced]))
  ignore(
    cli(
      ["accept-git", advanced, resolved, accepted, root + "/wrong.json"],
      error="different template baseline",
    ),
  )
  let captured_v2 = root + "/capture-v2.json"
  ignore(cli(["capture-git", repository, second, "service", captured_v2]))
  let batch_records = root + "/accepted-records"
  let live_source = @fs.read_file(source).binary()
  @fs.write_file(source, "external source record changed")
  ignore(cli(["accept-git-batch", individual_ready, batch_records]))
  @fs.write_file(source, live_source)
  for id in ["a-open", "z-protected"] {
    guard @fs.read_file(batch_records + "/" + id + ".json").binary() ==
      @fs.read_file(captured_v2).binary() else {
      fail("Batch acceptance must advance every captured template baseline")
    }
  }
  guard @fs.exists(batch_records + "/acceptance.json") &&
    @fs.read_file(ready_directory + "/z-ready/source.json").binary() == original else {
    fail(
      "Acceptance did not preserve captured provenance or issue its final marker",
    )
  }
  ignore(
    cli(
      ["accept-git-batch", individual_ready, batch_records],
      error="accepted-records",
    ),
  )
  let original_candidate = @fs.read_file(
    individual_ready + "/z-protected/candidate/project/settings.txt",
  ).binary()
  @fs.write_file(
    individual_ready + "/z-protected/candidate/project/settings.txt",
    "changed after review\n",
  )
  ignore(
    cli(
      ["accept-git-batch", individual_ready, root + "/partially-invalid"],
      error="Batch project z-protected",
    ),
  )
  guard !@fs.exists(root + "/partially-invalid") else {
    fail("Acceptance wrote records before validating every candidate")
  }
  @fs.write_file(
    individual_ready + "/z-protected/candidate/project/settings.txt",
    original_candidate,
  )
  ignore(cli(["accept-git-batch", individual_ready, root + "/accepted-retry"]))
  let collision_manifest = root + "/acceptance-name-manifest.json"
  let collision_rows = ["acceptance", "acceptance-source"].map(id => {
    Json::array([id, source, project, second].map(Json::string))
  })
  @fs.write_file(
    collision_manifest,
    Json::array([
      Json::string("moongraft.git-batch.v1"),
      Json::array(collision_rows),
    ]).stringify(),
  )
  let collision_batch = root + "/acceptance-name-batch"
  ignore(cli(["stage-git-batch", collision_manifest, collision_batch]))
  let collision_output = root + "/acceptance-name-records"
  let collision_receipt = cli([
    "accept-git-batch", collision_batch, collision_output,
  ])
  guard collision_receipt.trim() ==
    @fs.read_file(collision_output + "/acceptance.json").text().trim() &&
    collision_receipt.contains("\"source\":\"acceptance.source.json\"") &&
    collision_receipt.contains("\"source\":\"acceptance-source.json\"") &&
    collision_receipt.contains(
      "\"format\":\"moongraft.git-batch-acceptance.v1\"",
    ) else {
    fail(
      "Acceptance report must name distinct sources and match the completion marker",
    )
  }
  for filename in ["acceptance.source.json", "acceptance-source.json"] {
    guard @fs.read_file(collision_output + "/" + filename).binary() ==
      @fs.read_file(captured_v2).binary() else {
      fail("Acceptance filename collision replaced a project source")
    }
  }
  let batch_accepted = root + "/batch-source-v2.json"
  ignore(
    cli([
      "accept-git",
      source,
      batch + "/z-ready/plan.json",
      batch + "/z-ready/candidate/project",
      batch_accepted,
    ]),
  )
  guard @fs.read_file(advanced).binary() == @fs.read_file(captured_v2).binary() &&
    @fs.read_file(batch_accepted).binary() ==
    @fs.read_file(captured_v2).binary() &&
    @fs.read_file(source).binary() == original else {
    fail(
      "New source record must match the template alone and preserve the old record",
    )
  }
  ignore(git(repository, ["tag", "-f", "v3", second]))
  guard !cli(["discover-git", advanced]).contains("refs/tags/v3") else {
    fail(
      "Discovery must exclude a moved tag now pointing at the recorded revision",
    )
  }
  let next = root + "/next.json"
  let next_bundle = root + "/next"
  ignore(cli(["plan-git", advanced, accepted, third, next]))
  ignore(cli(["export", next, accepted, next_bundle]))
  guard @fs.read_file(next_bundle + "/project/guide.md").binary() ==
    b"Run the service tests.\n" &&
    @fs.read_file(next_bundle + "/project/business.txt").binary() ==
    b"team feature\n" else {
    fail("Second upgrade did not apply the new baseline")
  }
  let move_input = next_bundle + "/project"
  let third_source = root + "/third-source.json"
  ignore(cli(["accept-git", advanced, next, move_input, third_source]))
  @fs.write_file(move_input + "/settings.txt", "local settings\n")
  @fs.mkdir(repository + "/service/config")
  ignore(
    git(repository, [
      "mv", "service/settings.txt", "service/config/settings.txt",
    ]),
  )
  @fs.write_file(repository + "/service/config/settings.txt", "version=2\n")
  let fourth = commit(repository, "Move settings into config")
  let moves = root + "/renames.json"
  @fs.write_file(
    moves, "[\"moongraft.renames\",\"1\",[[\"settings.txt\",\"config/settings.txt\"]]]",
  )
  let move_plan = root + "/move-plan.json"
  let move_report = cli([
    "plan-git-renames", third_source, move_input, fourth, moves, move_plan,
  ])
  guard move_report.contains("move\tsettings.txt\tconfig/settings.txt") &&
    move_report.contains("Unresolved: 0") else {
    fail("The plan did not report the mapped Git move")
  }
  let move_bundle = root + "/move-candidate"
  let rendered_plan = root + "/rendered-move-plan.json"
  ignore(
    cli([
      "plan-renames",
      next_bundle + "/baseline.json",
      move_input,
      fourth,
      repository + "/service",
      moves,
      rendered_plan,
    ]),
  )
  guard @fs.read_file(rendered_plan).binary() ==
    @fs.read_file(move_plan).binary() else {
    fail("Git and rendered-directory inputs produced different move plans")
  }
  ignore(cli(["export", move_plan, move_input, move_bundle]))
  ignore(cli(["verify-export", move_bundle]))
  let moved = move_bundle + "/project"
  guard !@fs.exists(moved + "/settings.txt") &&
    @fs.read_file(moved + "/config/settings.txt").binary() ==
    b"local settings\n" &&
    @fs.read_file(moved + "/business.txt").binary() == b"team feature\n" else {
    fail("The moved candidate lost project customizations")
  }
  let fourth_source = root + "/fourth-source.json"
  ignore(cli(["accept-git", third_source, move_plan, moved, fourth_source]))
  guard cli(["check-git", fourth_source, fourth]).contains("Already recorded") else {
    fail(
      "Git acceptance did not advance to the unmodified new template baseline",
    )
  }
  let undo_move = root + "/undo-move"
  ignore(cli(["rollback-export", move_plan, moved, undo_move]))
  guard @fs.read_file(undo_move + "/project/settings.txt").binary() ==
    b"local settings\n" &&
    !@fs.exists(undo_move + "/project/config/settings.txt") &&
    @fs.read_file(undo_move + "/baseline.json").binary() ==
    @fs.read_file(next_bundle + "/baseline.json").binary() else {
    fail("Rollback did not restore both the old path and old baseline")
  }
  let cloned = root + "/template-copy"
  ignore(git(repository, ["clone", "--no-hardlinks", "--", repository, cloned]))
  @fs.rename(repository, root + "/template-original", replace=false)
  let relocated = root + "/relocated.json"
  ignore(cli(["relocate-git", advanced, cloned, relocated]))
  let relocated_again = root + "/relocated-again.json"
  ignore(cli(["relocate-git", relocated, cloned, relocated_again]))
  guard @fs.read_file(relocated).binary() ==
    @fs.read_file(relocated_again).binary() &&
    @fs.read_file(source).binary() == original else {
    fail("Relocation must be deterministic and preserve earlier source records")
  }
  let empty_repository = root + "/empty-repository"
  @fs.mkdir(empty_repository)
  ignore(git(empty_repository, ["init", "--object-format=sha1"]))
  let invalid_relocation = root + "/invalid-relocation.json"
  ignore(
    cli(
      ["relocate-git", advanced, empty_repository, invalid_relocation],
      error="Git cat-file failed",
    ),
  )
  guard !@fs.exists(invalid_relocation) else {
    fail("Invalid relocation wrote a record")
  }
  ignore(
    cli(
      [
        "accept-git",
        relocated,
        resolved,
        accepted,
        root + "/wrong-location.json",
      ],
      error="different template baseline",
    ),
  )
  let relocated_plan = root + "/relocated-plan.json"
  ignore(cli(["plan-git", relocated, accepted, third, relocated_plan]))
  ignore(
    cli(["export", relocated_plan, accepted, root + "/relocated-candidate"]),
  )
  guard @fs.read_file(root + "/relocated-candidate/project/business.txt").binary() ==
    b"team feature\n" &&
    @fs.read_file(root + "/relocated-candidate/project/guide.md").binary() ==
    b"Run the service tests.\n" else {
    fail(
      "Relocated source failed to preserve business files during its next upgrade",
    )
  }
  println(
    "Pinned Git template creation and successive upgrades verified in " + root,
  )
}
