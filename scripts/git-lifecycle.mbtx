----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}
----

///|
async fn git(repository : String, args : Array[String]) -> String {
  let output = @shell.Cmd("git", args, cwd=repository).output()
  output.check()
  output.stdout().trim().to_owned()
}

///|
async fn commit(repository : String, message : String) -> String {
  ignore(git(repository, ["add", "."]))
  ignore(
    git(repository, [
      "-c", "user.name=MoonGraft fixture", "-c", "user.email=fixture@example.invalid",
      "-c", "commit.gpgSign=false", "commit", "-m", message,
    ]),
  )
  git(repository, ["rev-parse", "HEAD"])
}

///|
async fn cli(args : Array[String], error? : String) -> String {
  let target = if @env.args()[1:] is ["native"] { "native" } else { "wasm" }
  let output = @shell.Cmd(
    "moon",
    ["run", "--target", target, "--deny-warn", "cmd/main", "--"] + args,
  ).output()
  match error {
    None => output.check()
    Some(message) => {
      guard output.exit_code() != 0 && output.stderr().contains(message) else {
        fail(
          "Expected diagnostic " +
          message +
          ": " +
          output.stdout() +
          output.stderr(),
        )
      }
    }
  }
  output.stdout()
}

///|
async fn main {
  let root = @fs.tmpdir(prefix="moongraft-git-")
  let repository = root + "/template"
  @fs.mkdir(repository)
  ignore(git(repository, ["init", "--object-format=sha1"]))
  ignore(git(repository, ["config", "core.autocrlf", "false"]))
  @fs.mkdir(repository + "/service")
  @fs.write_file(repository + "/outside.txt", "outside")
  @fs.write_file(repository + "/service/settings.txt", "version=1\n")
  @fs.write_file(repository + "/service/logo.bin", b"\x00\xff")
  let first = commit(repository, "service template v1")
  @fs.write_file(repository + "/service/settings.txt", "version=2\n")
  let second = commit(repository, "service template v2")
  @fs.write_file(repository + "/service/guide.md", "Run the service tests.\n")
  let third = commit(repository, "service template v3")
  @fs.write_file(repository + "/service/settings.txt", "uncommitted\n")

  let source = root + "/source.json"
  let duplicate = root + "/duplicate.json"
  let bundle = root + "/generated"
  ignore(
    cli(
      ["capture-git", repository, "HEAD", "service", duplicate],
      error="40-character Git commit SHA",
    ),
  )
  ignore(
    cli(
      ["capture-git", repository, first, "missing", duplicate],
      error="contains no files",
    ),
  )
  guard !@fs.exists(duplicate) else {
    fail("Invalid capture created an archive")
  }
  ignore(cli(["capture-git", repository, first, "service", source]))
  ignore(cli(["capture-git", repository, first, "service", duplicate]))
  guard @fs.read_file(source).binary() == @fs.read_file(duplicate).binary() else {
    fail("Repeated source capture must be byte-identical")
  }
  ignore(cli(["create-git", source, bundle]))
  ignore(cli(["verify-export", bundle]))
  guard @fs.read_file(bundle + "/project/settings.txt").binary() ==
    b"version=1\n" &&
    @fs.read_file(bundle + "/project/logo.bin").binary() == b"\x00\xff" &&
    !@fs.exists(bundle + "/project/outside.txt") else {
    fail("Generation failed to reproduce the selected committed subtree")
  }
  let unchanged = cli(["check-git", source, first])
  let changed = cli(["check-git", source, second])
  guard unchanged.contains("Already recorded") &&
    changed.contains("template changes") else {
    fail("Unexpected source version check")
  }
  let project = bundle + "/project"
  let plan = root + "/plan.json"
  let resolved = root + "/resolved.json"
  let candidate = root + "/candidate"
  let advanced = root + "/source-v2.json"
  let original = @fs.read_file(source).binary()
  @fs.write_file(project + "/settings.txt", "version=team\n")
  @fs.write_file(project + "/business.txt", "team feature\n")
  let report = cli(["plan-git", source, project, second, plan])
  guard report.contains("Unresolved: 1") else {
    fail("Expected overlapping settings edits to require a decision")
  }
  ignore(
    cli(["export", plan, project, candidate], error="Resolve these conflicts"),
  )
  ignore(cli(["resolve", plan, "settings.txt", "take-template", resolved]))
  ignore(cli(["export", resolved, project, candidate]))
  let accepted = candidate + "/project"
  guard @fs.read_file(accepted + "/settings.txt").binary() == b"version=2\n" &&
    @fs.read_file(accepted + "/business.txt").binary() == b"team feature\n" &&
    @fs.read_file(project + "/settings.txt").binary() == b"version=team\n" else {
    fail(
      "Candidate must contain the chosen template edit and preserve business files",
    )
  }
  @fs.write_file(accepted + "/business.txt", "unexpected edit\n")
  ignore(
    cli(
      ["accept-git", source, resolved, accepted, advanced],
      error="differs from the resolved candidate",
    ),
  )
  guard !@fs.exists(advanced) && @fs.read_file(source).binary() == original else {
    fail("Failed acceptance wrote a source record")
  }
  @fs.write_file(accepted + "/business.txt", "team feature\n")
  ignore(cli(["accept-git", source, resolved, accepted, advanced]))
  ignore(
    cli(
      ["accept-git", advanced, resolved, accepted, root + "/wrong.json"],
      error="different template baseline",
    ),
  )
  let captured_v2 = root + "/capture-v2.json"
  ignore(cli(["capture-git", repository, second, "service", captured_v2]))
  guard @fs.read_file(advanced).binary() == @fs.read_file(captured_v2).binary() &&
    @fs.read_file(source).binary() == original else {
    fail(
      "New source record must match the template alone and preserve the old record",
    )
  }
  let next = root + "/next.json"
  let next_bundle = root + "/next"
  ignore(cli(["plan-git", advanced, accepted, third, next]))
  ignore(cli(["export", next, accepted, next_bundle]))
  guard @fs.read_file(next_bundle + "/project/guide.md").binary() ==
    b"Run the service tests.\n" &&
    @fs.read_file(next_bundle + "/project/business.txt").binary() ==
    b"team feature\n" else {
    fail("Second upgrade did not apply the new baseline")
  }
  println(
    "Pinned Git template creation and successive upgrades verified in " + root,
  )
}
